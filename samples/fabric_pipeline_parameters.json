{
  "description": "Fabric notebook Base parameters: use these exact case-sensitive parameter-cell names, not environment-variable aliases. Collection values are JSON strings. Replace placeholders before use; these values are not a complete pipeline definition.",
  "parameters": {
    "WORKSPACE_ID": "<fabric-workspace-id-or-empty-when-attached>",
    "LAKEHOUSE_ID": "<fabric-lakehouse-id-or-empty-when-attached>",
    "BRONZE_TABLE": "osducatalog",
    "ADME_ENDPOINT": "https://<adme-instance>.energy.azure.com",
    "ADME_DATA_PARTITION_ID": "<data-partition-id>",
    "ADME_AUTH_METHOD": "MI",
    "ADME_MANAGED_IDENTITY_CLIENT_ID": "",
    "RUN_PROFILE": "execute",
    "KINDS": "[\"*:*:*:*\"]",
    "EXCLUDED_KINDS": "[]",
    "WRITE_MODE": "upsert",
    "INCREMENTAL_WATERMARK_COLUMN": "ingestTime",
    "INCREMENTAL_WATERMARK_MODE": "required",
    "OUTPUT_MODE": "normalized",
    "WRITE_RELATIONSHIP_BRIDGES": true,
    "ALLOW_OVERWRITE": false,
    "SCHEMA_FETCH_PARALLELISM": 4,
    "DATA_QUALITY_CHECKS": true,
    "OUTPUT_DOCS_MODE": "summary"
  }
}
